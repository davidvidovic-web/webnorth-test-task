# Ignore node_modules directory
node_modules/

# Ignore build output directories
dist/
build/

# Ignore log files and databases
*.log
*.sql
*.sqlite

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore IDE specific files
.vscode/
.idea/

# Ignore compiled CSS and JS files
*.css.map
*.js.map

# Ignore SASS cache files
.sass-cache/

# Ignore npm debug files
npm-debug.log*

# Ignore environment variable files
.env

# Ignore WordPress specific files
wp-config.php
.htaccess

# Ignore Composer dependencies
vendor/

# Ignore local configuration files
local-config.php

# Ignore any other sensitive or temporary files
*.bak
*.tmp
*.swp